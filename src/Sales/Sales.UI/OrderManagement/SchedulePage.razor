    private async Task OnDateRangeChanged(DateRange dateRange)
    {
        if (dateRange.Start is null ||
            dateRange.End is null)
        {
            return;
        }

        var organization =
            await OrganizationProvider.GetCurrentOrganizationAsync();

        var start = DateTime.SpecifyKind(
            dateRange.Start.Value,
            DateTimeKind.Local);

        var end = DateTime.SpecifyKind(
            dateRange.End.Value,
            DateTimeKind.Local);

        DateTimeOffset plannedStart = start;
        DateTimeOffset plannedEnd = end;

        if (plannedStart == plannedEnd)
        {
            plannedEnd = plannedEnd.AddDays(1);
        }

        await GetOrders(
            organization.Id,
            plannedStart,
            plannedEnd);
    }

